{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure OpenWAM Debug",
      "type": "process",
      "command": "cmake",
      "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build-debug", "-DCMAKE_BUILD_TYPE=Debug"],
      "problemMatcher": []
    },
    {
      "label": "Build OpenWAM Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build-debug", "--parallel", "2"],
      "dependsOn": "Configure OpenWAM Debug",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}
