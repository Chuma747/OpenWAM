{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug OpenWAM",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/bin/debug/OpenWAM",
      "args": ["${workspaceFolder}/input/4VPA6B 2.WAM"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Build OpenWAM Debug",
      "setupCommands": [
        {
          "description": "Stop at the original C++ exception",
          "text": "catch throw",
          "ignoreFailures": false
        }
      ]
    }
  ]
}
